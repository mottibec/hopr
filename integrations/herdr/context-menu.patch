+    fn invoke_hopr_menu(&mut self, menu: ClientContextMenuOverlay, outcome: &mut ClientShellInput) {
+        use crate::api::schema::{CommandInvokeParams, Method};
+        use crate::protocol::ClientShellCommandAction;
+
+        let Some(snapshot) = self.snapshot.as_deref() else {
+            return;
+        };
+        if menu.endpoint_id != self.active_endpoint_id || menu.boot_id != snapshot.boot_id {
+            self.endpoint_error = Some("The source machine changed; open the menu again".into());
+            return;
+        }
+        let (workspace_id, pane_id) = match menu.target {
+            ClientContextMenuTarget::Workspace { workspace_id, .. } => {
+                let mut agents = snapshot
+                    .agents
+                    .iter()
+                    .filter(|agent| agent.workspace_id == workspace_id);
+                let pane_id = match (agents.next(), agents.next()) {
+                    (Some(agent), None) => agent.pane_id.clone(),
+                    _ => {
+                        self.endpoint_error = Some("Move requires one agent in the clicked workspace; right-click the specific agent pane".into());
+                        return;
+                    }
+                };
+                (workspace_id, pane_id)
+            }
+            ClientContextMenuTarget::Pane {
+                workspace_id,
+                pane_id,
+                ..
+            } => (workspace_id, pane_id),
+            ClientContextMenuTarget::Tab { .. } => return,
+        };
+        if !snapshot
+            .panes
+            .iter()
+            .any(|pane| pane.pane_id == pane_id && pane.workspace_id == workspace_id)
+        {
+            self.endpoint_error = Some("The source pane disappeared; open the menu again".into());
+            return;
+        }
+        // The existing command manifest exposes descriptions and opaque IDs, not shell commands.
+        let mut commands = snapshot.commands.iter().filter(|command| {
+            command.action == ClientShellCommandAction::Popup
+                && command.description.as_deref() == Some("Move agent to another Mac")
+        });
+        let command_id = match (commands.next(), commands.next()) {
+            (Some(command), None) => command.command_id.clone(),
+            _ => {
+                self.endpoint_error = Some("Configure exactly one Hopr popup on this machine with description 'Move agent to another Mac', then reload config".into());
+                return;
+            }
+        };
+        self.popup_pending = true;
+        self.popup_pending_deadline = None;
+        if !self.push_endpoint_method_with_kind(
+            Method::CommandInvoke(CommandInvokeParams {
+                command_id,
+                workspace_id: Some(workspace_id),
+                tab_id: None,
+                pane_id: Some(pane_id),
+                selection: None,
+            }),
+            PendingEndpointKind::PopupCommand,
+            outcome,
+        ) {
+            self.popup_pending = false;
+        }
+    }
