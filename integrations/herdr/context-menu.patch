+++ b/src/client/shell/tests/hopr.rs
@@ -0,0 +1,203 @@
+use super::*;
+use crate::client::endpoint::{
+    ClientEndpointId, ClientEndpointStatus, ProfileId, SavedSshEndpoint,
+};
+
+fn projection() -> ClientShellSnapshot {
+    let mut s = snapshot();
+    s.agents.push(ClientShellAgent {
+        pane_id: "pane_1".into(),
+        workspace_id: "ws_1".into(),
+        tab_id: "tab_1".into(),
+        name: None,
+        display_agent: None,
+        agent: Some("codex".into()),
+        title: None,
+        terminal_title: None,
+        terminal_title_stripped: None,
+        agent_status: AgentStatus::Idle,
+        state_change_seq: 0,
+        state_labels: vec![],
+        tokens: vec![],
+        focused: true,
+    });
+    s.commands.push(crate::protocol::ClientShellCommand {
+        command_id: "hopr-local".into(),
+        binding_label: "prefix+alt+m".into(),
+        binding_labels: vec!["prefix+alt+m".into()],
+        action: crate::protocol::ClientShellCommandAction::Popup,
+        description: Some("Move agent to another Mac".into()),
+    });
+    s
+}
+
+fn state(s: ClientShellSnapshot) -> ClientShellState {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(s));
+    state.set_pane_surface(surface());
+    state
+}
+
+fn invoke(state: &mut ClientShellState) -> ClientShellInput {
+    let Some(ClientShellOverlay::ContextMenu(menu)) = state.overlay.as_ref() else {
+        panic!("menu")
+    };
+    let index = menu
+        .items()
+        .iter()
+        .position(|item| item.action == ClientContextMenuAction::HoprMove)
+        .unwrap();
+    let mut outcome = ClientShellInput::default();
+    state.activate_context_menu_item(index, &mut outcome);
+    outcome
+}
+
+#[test]
+fn hopr_right_click_uses_clicked_workspace_agent_and_one_atomic_request() {
+    let mut s = projection();
+    s.focused_workspace_id = Some("another-workspace".into());
+    s.focused_pane_id = Some("another-pane".into());
+    let mut state = state(s);
+    state.compose(106, 30).unwrap();
+    let rect = state.hits.workspaces[0].rect;
+    let click = state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Right),
+        column: rect.x + 2,
+        row: rect.y,
+        modifiers: KeyModifiers::empty(),
+    })]);
+    assert!(click.actions.is_empty());
+    let outcome = invoke(&mut state);
+    let [ClientShellAction::Endpoint {
+        endpoint_id,
+        boot_id,
+        request,
+    }] = &outcome.actions[..]
+    else {
+        panic!("one request")
+    };
+    assert_eq!(endpoint_id, &ClientEndpointId::Local);
+    assert_eq!(boot_id, "boot-1");
+    let crate::api::schema::Method::CommandInvoke(params) = &request.method else {
+        panic!("command.invoke")
+    };
+    assert_eq!(params.command_id, "hopr-local");
+    assert_eq!(params.workspace_id.as_deref(), Some("ws_1"));
+    assert_eq!(params.pane_id.as_deref(), Some("pane_1"));
+    assert!(params.tab_id.is_none());
+    assert!(params.selection.is_none());
+    assert!(state.popup_pending);
+    assert!(state.cancel_endpoint_request(&request.id));
+    assert!(!state.popup_pending);
+}
+
+#[test]
+fn hopr_workspace_refuses_missing_or_ambiguous_agents_but_pane_is_exact() {
+    for count in [0, 2] {
+        let mut s = projection();
+        s.agents = vec![s.agents[0].clone(); count];
+        let mut state = state(s);
+        state.open_workspace_context_menu("ws_1".into(), 0, 0);
+        assert!(invoke(&mut state).actions.is_empty());
+        assert!(!state.popup_pending);
+        assert!(state
+            .endpoint_error
+            .as_deref()
+            .unwrap()
+            .contains("one agent"));
+        state.open_pane_context_menu("pane_1".into(), 0, 0);
+        assert_eq!(invoke(&mut state).actions.len(), 1);
+    }
+}
+
+#[test]
+fn hopr_requires_one_popup_binding_on_source_server() {
+    for variant in 0..3 {
+        let mut s = projection();
+        match variant {
+            0 => s.commands.clear(),
+            1 => s.commands.push(s.commands[0].clone()),
+            _ => s.commands[0].action = crate::protocol::ClientShellCommandAction::Shell,
+        }
+        let mut state = state(s);
+        state.open_workspace_context_menu("ws_1".into(), 0, 0);
+        assert!(invoke(&mut state).actions.is_empty());
+        assert!(!state.popup_pending);
+        assert!(state
+            .endpoint_error
+            .as_deref()
+            .unwrap()
+            .contains("exactly one Hopr popup"));
+    }
+}
+
+#[test]
+fn hopr_scopes_duplicate_pane_ids_to_machine_and_server_boot() {
+    let mut state = state(projection());
+    let profile = SavedSshEndpoint {
+        id: ProfileId::parse("0123456789abcdef0123456789abcdef").unwrap(),
+        label: "Home".into(),
+        target: "test@home".into(),
+        session: "default".into(),
+        enabled: true,
+    };
+    let remote = ClientEndpointId::Ssh(profile.id.clone());
+    state.set_endpoint_catalog(&[profile]);
+    state.set_endpoint_status(&remote, ClientEndpointStatus::Online);
+    let mut s = projection();
+    s.boot_id = "home-boot".into();
+    s.commands[0].command_id = "hopr-home".into();
+    state.set_endpoint_snapshot(&remote, Box::new(s));
+    state.open_workspace_context_menu("ws_1".into(), 0, 0);
+    let old_menu = state.overlay.take();
+    assert!(state.activate_endpoint_projection(&remote));
+    state.overlay = old_menu;
+    assert!(invoke(&mut state).actions.is_empty());
+    assert!(state
+        .endpoint_error
+        .as_deref()
+        .unwrap()
+        .contains("source machine changed"));
+
+    state.open_workspace_context_menu("ws_1".into(), 0, 0);
+    let outcome = invoke(&mut state);
+    let [ClientShellAction::Endpoint {
+        endpoint_id,
+        boot_id,
+        request,
+    }] = &outcome.actions[..]
+    else {
+        panic!("remote request")
+    };
+    assert_eq!(endpoint_id, &remote);
+    assert_eq!(boot_id, "home-boot");
+    let crate::api::schema::Method::CommandInvoke(params) = &request.method else {
+        panic!("command.invoke")
+    };
+    assert_eq!(params.command_id, "hopr-home");
+    state.cancel_endpoint_request(&request.id);
+
+    state.open_pane_context_menu("pane_1".into(), 0, 0);
+    state.snapshot.as_mut().unwrap().boot_id = "restarted".into();
+    assert!(invoke(&mut state).actions.is_empty());
+    assert!(!state.popup_pending);
+}
+
+#[test]
+fn hopr_disconnected_or_removed_source_cannot_launch() {
+    let mut state = state(projection());
+    state.open_workspace_context_menu("ws_1".into(), 0, 0);
+    state.snapshot.as_mut().unwrap().panes.clear();
+    assert!(invoke(&mut state).actions.is_empty());
+    assert!(state
+        .endpoint_error
+        .as_deref()
+        .unwrap()
+        .contains("pane disappeared"));
+
+    let mut state = self::state(projection());
+    state.open_pane_context_menu("pane_1".into(), 0, 0);
+    state.mark_endpoint_disconnected(&ClientEndpointId::Local);
+    assert!(invoke(&mut state).actions.is_empty());
+    assert!(!state.popup_pending);
+}
